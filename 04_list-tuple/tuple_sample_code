# TUPLE PRACTICE – FULL CONCEPT

# Creating tuple
fruits = ("apple", "banana", "mango", "apple")
print("Tuple:", fruits)

# Indexing
print("First fruit:", fruits[0])
print("Last fruit:", fruits[-1])

# Slicing
print("First two fruits:", fruits[0:2])

# Count & index methods
print("Count of apple:", fruits.count("apple"))
print("Index of mango:", fruits.index("mango"))

# Length
print("Tuple length:", len(fruits))

# Looping through tuple
print("Looping through tuple:")
for fruit in fruits:
    print(fruit)

# Tuple unpacking
a, b, c, d = fruits
print("Unpacked values:", a, b, c, d)
