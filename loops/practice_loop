# PYTHON LOOPS PRACTICE – FULL CONCEPT

print("----- FOR LOOP -----")

# Basic for loop
for i in range(1, 6):
    print("Number:", i)

print("\n----- WHILE LOOP -----")

# Basic while loop
count = 1
while count <= 5:
    print("Count:", count)
    count += 1


print("\n----- BREAK STATEMENT -----")

# Break example
for i in range(1, 10):
    if i == 5:
        print("Breaking at:", i)
        break
    print(i)


print("\n----- CONTINUE STATEMENT -----")

# Continue example
for i in range(1, 6):
    if i == 3:
        continue
    print(i)


print("\n----- PASS STATEMENT -----")

# Pass example
for i in range(1, 4):
    pass

print("Pass statement executed successfully")


print("\n----- NESTED LOOP -----")

# Nested loop example
for i in range(1, 4):
    for j in range(1, 4):
        print("i =", i, "j =", j)


print("\n----- PATTERN PRINTING -----")

# Pattern printing
rows = 4
for i in range(1, rows + 1):
    for j in range(i):
        print("*", end=" ")
    print()


print("\n----- LOOP WITH LIST -----")

numbers = [10, 20, 30, 40]

for num in numbers:
    print("List item:", num)